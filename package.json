{
  "name": "@deckflow/deckrender",
  "version": "0.3.2",
  "description": "Render PPTX, PDF, DOCX, Keynote, HTML and Markdown into images, PDF or video. One command, predictable output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "deckrender": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "dev": "tsup --watch",
    "dev:browser": "tsup --config tsup.browser.config.ts --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:cloud": "vitest run tests/e2e/cloud.test.ts",
    "test:local": "vitest run tests/e2e/local.test.ts tests/e2e/lazy-slides.test.ts",
    "verify:office2html": "node scripts/verify-office2html.mjs",
    "test:packaging": "node scripts/verify-office2html-install.mjs",
    "test:consumer": "node node_modules/typescript-7/bin/tsc -p tests/consumer/tsconfig.json",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:browser:e2e": "node scripts/run-browser-e2e.mjs",
    "test:conformance": "node scripts/conformance.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.browser.json --noEmit",
    "check": "pnpm verify:office2html && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:consumer && pnpm test:browser"
  },
  "keywords": [
    "cli",
    "render",
    "deckflow",
    "pptx",
    "pdf",
    "keynote",
    "docx",
    "screenshot",
    "thumbnail",
    "document-conversion"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckflow/deckrender.git"
  },
  "homepage": "https://github.com/deckflow/deckrender#readme",
  "bugs": {
    "url": "https://github.com/deckflow/deckrender/issues"
  },
  "dependencies": {
    "@deckops/sdk": "0.7.3",
    "@types/node": "^20.10.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "open": "^11.0.0",
    "ora": "^7.0.0",
    "p-limit": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "optionalDependencies": {
    "@deckflow/office2html": "0.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.8.69",
    "playwright-core": "1.55.1"
  }
}
