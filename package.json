{
  "name": "@deckflow/deckrender",
  "version": "0.1.1",
  "description": "Render any document format into visual artifacts. PPTX, PDF, DOCX, Keynote, HTML and Markdown to images, PDF or video.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "deckrender": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:cloud": "vitest run tests/e2e/cloud.test.ts",
    "test:consumer": "node node_modules/typescript-7/bin/tsc -p tests/consumer/tsconfig.json",
    "test:conformance": "node scripts/conformance.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:consumer"
  },
  "keywords": [
    "cli",
    "render",
    "deckflow",
    "pptx",
    "pdf",
    "keynote",
    "docx",
    "screenshot",
    "thumbnail",
    "document-conversion"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckflow/deckrender.git"
  },
  "homepage": "https://github.com/deckflow/deckrender#readme",
  "bugs": {
    "url": "https://github.com/deckflow/deckrender/issues"
  },
  "dependencies": {
    "@deckops/sdk": "^0.7.3",
    "@types/node": "^20.10.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "open": "^11.0.0",
    "ora": "^7.0.0",
    "p-limit": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
